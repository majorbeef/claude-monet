#!/usr/bin/env python3
"""monet-statusline: a Claude Code status line for watching token cost.

Shows the model, how full the context window is (green, then yellow past 50%,
red past 75% with a /compact hint), the prompt-cache hit rate of the last
request, and the session's estimated cost:

    Opus · ▓▓▓░░░░░░░ 34% ctx · cache 92% · $1.23

Claude Code runs it with the session as JSON on stdin. Self-contained, so it can
live outside the plugin, whose folder changes on every update.

    monet-statusline --install    copy to ~/.claude/monet/statusline.py and set it in ~/.claude/settings.json
"""
import json
import os
import shutil
import sys
from pathlib import Path

GREEN, YELLOW, RED, DIM, RESET = "\033[32m", "\033[33m", "\033[31m", "\033[2m", "\033[0m"


def number(value):
    try:
        return float(value)
    except (TypeError, ValueError):
        return None


def render(data, color=True):
    paint = (lambda code, text: f"{code}{text}{RESET}") if color else (lambda code, text: text)
    parts = [(data.get("model") or {}).get("display_name") or "Claude"]

    window = data.get("context_window") or {}
    pct = number(window.get("used_percentage"))
    if pct is not None:
        filled = max(0, min(10, round(pct / 10)))
        bar = "▓" * filled + "░" * (10 - filled)
        code = GREEN if pct < 50 else YELLOW if pct < 75 else RED
        text = f"{bar} {pct:.0f}% ctx"
        if pct >= 75:
            text += " /compact?"
        parts.append(paint(code, text))

    usage = window.get("current_usage") or {}
    read = number(usage.get("cache_read_input_tokens")) or 0
    total = read + (number(usage.get("input_tokens")) or 0) + (number(usage.get("cache_creation_input_tokens")) or 0)
    if total > 0:
        parts.append(paint(DIM, f"cache {read / total:.0%}"))

    cost = number((data.get("cost") or {}).get("total_cost_usd"))
    if cost is not None:
        parts.append(f"${cost:.2f}")
    return " · ".join(parts)


def install(force=False):
    home = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
    target = home / "monet" / "statusline.py"
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(Path(__file__).resolve(), target)
    target.chmod(0o755)
    settings_file = home / "settings.json"
    settings = json.loads(settings_file.read_text()) if settings_file.exists() else {}
    wanted = {"type": "command", "command": f"python3 {target}"}
    current = settings.get("statusLine")
    if current and current.get("command") != wanted["command"] and not force:
        print(f"monet-statusline: {settings_file} already has a status line:\n  {json.dumps(current)}\n"
              "Run again with --force to replace it.", file=sys.stderr)
        return 1
    if settings_file.exists():
        shutil.copyfile(settings_file, settings_file.with_name("settings.json.bak"))
    settings["statusLine"] = wanted
    settings_file.write_text(json.dumps(settings, indent=2) + "\n")
    print(f"Installed {target} as the status line in {settings_file}. It shows from the next message.")
    return 0


def main(argv):
    if "--install" in argv:
        return install(force="--force" in argv)
    if "-h" in argv or "--help" in argv:
        print(__doc__)
        return 0
    try:
        data = json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError):
        data = {}
    print(render(data, color="--no-color" not in argv))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
