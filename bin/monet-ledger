#!/usr/bin/env python3
"""monet-ledger: create and move tasks in the project's .ledger/ workbench."""
import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import ledger  # noqa: E402
import notebook  # noqa: E402


def main(argv=None):
    parser = argparse.ArgumentParser(prog="monet-ledger", description=__doc__)
    parser.add_argument("--root", help="project root (default: nearest directory with .ledger/, else the git top level)")
    parser.add_argument("--json", action="store_true", help="print machine-readable results")
    sub = parser.add_subparsers(dest="command", required=True)

    add = sub.add_parser("add", help="create a new task bundle with task.md, retrospective.md, and an index row")
    add.add_argument("--title", required=True, help="one-line title, 1-160 characters")
    add.add_argument("--description", required=True, help="one-line search summary, 1-400 characters")
    add.add_argument("--slug", help="lowercase kebab slug (default: derived from the title)")

    status = sub.add_parser("status", help="move a live task to a new status; done/cancelled archive it to history")
    status.add_argument("task", help="task id, .ledger/<id>, or .ledger/<id>/task.md")
    status.add_argument("status", choices=ledger.STATUSES)
    status.add_argument(
        "--learnings-distilled",
        action="store_true",
        help="close even though this session still has open notebook learnings",
    )

    sub.add_parser("list", help="list live tasks")
    sub.add_parser("contract", help="print the ledger working agreement")

    args = parser.parse_args(argv)
    root = Path(args.root).resolve() if args.root else ledger.find_root(os.getcwd())

    try:
        if args.command == "contract":
            print(ledger.LEDGER_CONTRACT)
            return 0
        if args.command == "list":
            tasks = ledger.live_tasks(root)
            if args.json:
                print(json.dumps(tasks, indent=2))
            elif not tasks:
                print("No live ledger tasks.")
            else:
                for t in tasks:
                    print(f"{t['taskPath']} — {t['status']} — {t['title']}")
            return 0
        if args.command == "add":
            result = ledger.add_task(root, args.title, args.description, args.slug)
            print(json.dumps(result) if args.json else f"Added {result['taskPath']}")
            return 0
        if args.command == "status":
            if args.status in ledger.CLOSED_STATUSES and not args.learnings_distilled:
                sid = os.environ.get("MONET_SESSION_ID")
                learnings = notebook.open_learnings(sid) if sid else []
                if learnings:
                    print(
                        "Not closed yet: this session has open notebook learnings. Distill them while this task's "
                        "retrospective.md is still live (lessons about this task belong there), then run this command "
                        "again with --learnings-distilled.\n\n" + notebook.distill_prompt(learnings),
                        file=sys.stderr,
                    )
                    return 3
            result = ledger.set_status(root, args.task, args.status)
            verb = "Archived" if args.status in ledger.CLOSED_STATUSES else "Moved"
            print(json.dumps(result) if args.json else f"{verb} {result['taskPath']} to {result['status']}")
            return 0
    except (ledger.LedgerError, notebook.NotebookError) as error:
        print(f"monet-ledger: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
