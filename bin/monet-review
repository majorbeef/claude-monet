#!/usr/bin/env python3
"""monet-review: open a Markdown file as a review page in the browser and wait for the verdict.

The reviewer reads the rendered document, selects text to comment, label, mark for
deletion, or suggest a rewrite, comments on or rewrites whole blocks, adds an overall
comment, and presses Finish. The feedback is printed with path:line anchors. The
file itself is never changed.

Runs until the reviewer finishes, so Claude should start it in the background.
Exit codes: 0 feedback received, 2 timed out, 1 error.
"""
import argparse
import json
import sys
import webbrowser
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import review  # noqa: E402


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="monet-review", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("path", help="the Markdown file to review")
    parser.add_argument("--note", help="one sentence shown above the document: what you need from the reviewer")
    parser.add_argument("--timeout", type=float, help="give up after this many seconds (default: wait)")
    parser.add_argument("--no-open", action="store_true", help="print the address without opening a browser")
    parser.add_argument("--json", action="store_true", help="print the result as JSON")
    args = parser.parse_args(argv)

    try:
        page = review.build_page(args.path, args.note)
    except (OSError, UnicodeDecodeError) as error:
        print(f"monet-review: cannot read {args.path}: {error}", file=sys.stderr)
        return 1
    review.keep_scratch_out_of_git(args.path)
    server = review.ReviewServer(page)
    print(f"Review page for {page['path']}: {server.url}", flush=True)
    print("Waiting for the reviewer to press Finish...", flush=True)
    if not args.no_open:
        webbrowser.open(server.url)
    result = server.serve_until_done(args.timeout)
    if result is None:
        print("monet-review: timed out before the reviewer finished.", file=sys.stderr)
        return 2
    print()
    print(json.dumps(result, indent=2, ensure_ascii=False) if args.json else review.format_result(result, page))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
